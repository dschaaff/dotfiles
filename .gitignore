.DS_Store
*.bak

agents/.agents/skills/.claude

bin/bin/docker
bin/bin/docker-buildx
bin/bin/docker-compose
bin/bin/docker-credential-osxkeychain
bin/bin/kubectl
bin/bin/linkerd
