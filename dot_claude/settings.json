{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "awsAuthRefresh": "granted sso login --sso-start-url https://cordial-sso.awsapps.com/start --sso-region us-west-2",
  "cleanupPeriodDays": 365,
  "permissions": {
    "allow": [
      "Skill(superpowers:*)",
      "Read(~/.claude/plugins/cache/**)",
      "Bash(/Users/danielschaaff/.claude/plugins/cache/claude-plugins-official/superpowers/*)",
      "Write(**/.git/sdd/**)",
      "Edit(**/.git/sdd/**)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git clone:*)",
      "Bash(coderabbit:*)",
      "Bash(trash:*)",
      "Bash(nono why *)",
      "Bash(nono profile guide)",
      "Bash(nono profile validate *)",
      "Bash(nono profile show *)",
      "Bash(chezmoi diff *)",
      "Bash(chezmoi managed *)",
      "Bash(chezmoi cat *)",
      "Bash(chezmoi verify *)",
      "Bash(chezmoi source-path *)",
      "Bash(gofmt -l *)",
      "Bash(npm view *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(wget *|bash*)",
      "Bash(wget *| bash*)",
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(git reset --hard*)",
      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Edit(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.git-credentials)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/**)",
      "Read(~/.npmrc)",
      "Read(~/.npm/**)",
      "Read(~/.pypirc)",
      "Read(~/.gem/credentials)",
      "Read(~/Library/Keychains/**)",
      "Read(~/Library/Application Support/**/metamask*/**)",
      "Read(~/Library/Application Support/**/electrum*/**)",
      "Read(~/Library/Application Support/**/exodus*/**)",
      "Read(~/Library/Application Support/**/phantom*/**)",
      "Read(~/Library/Application Support/**/solflare*/**)"
    ]
  },
  "model": "us.anthropic.claude-opus-4-8[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CMD=$(jq -r '.tool_input.command'); if echo \"$CMD\" | grep -qiE '(^|;[[:space:]]*|&&[[:space:]]*|[|][|][[:space:]]*|[|][[:space:]]*)rm[[:space:]]' && echo \"$CMD\" | grep -qiE '(^|[[:space:]])-[a-zA-Z]*[rR]|--recursive' && echo \"$CMD\" | grep -qiE '(^|[[:space:]])-[a-zA-Z]*[fF]|--force'; then echo 'BLOCKED: Use trash instead of rm -rf' >&2; exit 2; fi"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); cwd=$(echo \"$input\" | jq -r '.cwd // empty'); parts=(); [ -n \"$cwd\" ] && parts+=(\"$(echo $cwd | sed \"s|$HOME|~|\")\"); ctx=$(kubectl config current-context 2>/dev/null) && ns=$(kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null) && parts+=(\"k8s:${ctx}${ns:+($ns)}\"); branch=$(git -C \"${cwd:-.}\" rev-parse --abbrev-ref HEAD 2>/dev/null) && parts+=(\"git:${branch}\"); profile=${AWS_PROFILE:-${AWS_DEFAULT_PROFILE:-}} && [ -n \"$profile\" ] && parts+=(\"aws:${profile}\"); used=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); [ -n \"$used\" ] && parts+=(\"ctx:${used}%\"); model=$(echo \"$input\" | jq -r '.model.display_name // empty'); [ -n \"$model\" ] && parts+=(\"model:${model}\"); echo \"${parts[*]}\""
  },
  "enabledPlugins": {
    "alert-debug@cordial-claude-code": true,
    "backstage-platform@cordial-claude-code": true,
    "code-review@schaaff-claude-code": true,
    "grafana-mcp@cordial-claude-code": true,
    "lua-lsp@claude-plugins-official": true,
    "php-lsp@claude-plugins-official": true,
    "tofu-terraform@cordial-claude-code": true,
    "coderabbit@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "codex@openai-codex": true,
    "atlassian@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true,
    "laravel-boost@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "release-tools@cordial-claude-code": true,
    "mta-operations@cordial-claude-code": true,
    "gopls-lsp@claude-plugins-official": true,
    "clickhouse-best-practices@claude-plugins-official": true,
    "ast-grep@ast-grep-marketplace": true,
    "aws-core@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "gemini-plugin-cc": {
      "source": {
        "source": "github",
        "repo": "DuncanSchouten/gemini-plugin-cc"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "ast-grep-marketplace": {
      "source": {
        "source": "github",
        "repo": "ast-grep/agent-skill"
      }
    }
  },
  "outputStyle": "Explanatory",
  "env": {
    "AWS_MCP_PROXY_PROFILES": "Cordial-Development/ReadOnly Cordial-Production-East/ReadOnly Cordial-Production/ReadOnly MTA-dev/ReadOnly MTA/ReadOnly Production-Bravo/ReadOnly SRE-dev/ReadOnly SRE-prod/ReadOnly cordial-ecr/ReadOnly datalake/ReadOnly dev-datalake/ReadOnly sre-interview-sandbox/ReadOnly security-tooling/FullAccess"
  },
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "api.opsgenie.com",
        "app.coderabbit.ai",
        "cli.coderabbit.ai",
        "gitlab.com",
        "github.com",
        "githubusercontent.com",
        "cordial.atlassian.net",
        "mcp.atlassian.com",
        "slack.com",
        "opentofu.org",
        "terraform.io",
        "registry.terraform.io",
        "registry.opentofu.org",
        "get.opentofu.org",
        "releases.hashicorp.com",
        "proxy.golang.org",
        "sum.golang.org",
        "*.amazonaws.com"
      ],
      "allowUnixSockets": [
        "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock",
        "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/s.sock"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "unix:///Users/danielschaaff/.rd/docker.sock",
        "~/Library/Caches/go-build/",
        "~/go/pkg/mod/cache/",
        "~/Library/Caches/helm/",
        "~/.cache/prek/",
        "~/.terraform.d/plugin-cache/",
        "~/.claude/plugins/data/",
        "~/.kube/cache",
        "~/.aws/sso/cache",
        "~/.aws/cli/cache",
        "~/.config",
        "~/.cache",
        "~/Library/Caches"
      ],
      "allowRead": [
        "~/development/",
        "~/.gitconfig",
        "~/.gitignore_global",
        "~/.config/git/ignore",
        "~/.ssh/known_hosts",
        "~/.ssh/config",
        "~/.config/codex/",
        "~/.cargo/bin",
        "~/go/bin",
        "~/.pyenv/shims",
        "~/.pyenv/bin",
        "~/.local/share/fnm",
        "~/.local/share/pnpm",
        "~/.rbenv/shims",
        "~/.rbenv/bin",
        "~/.local/bin",
        "~/bin",
        "/Users/danielschaaff/.bun/bin",
        "/Users/danielschaaff/.rd/bin",
        "/usr/local/sbin",
        "/opt/homebrew/bin"
      ]
    },
    "enableWeakerNetworkIsolation": true,
    "excludedCommands": [
      "/opt/homebrew/bin/codex*",
      "codex*",
      "coderabbit*",
      "trash*",
      "git push",
      "git fetch",
      "git pull",
      "git clone"
    ]
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "skipWorkflowUsageWarning": true
}
