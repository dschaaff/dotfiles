{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "~/development/gitlab/CordialExperiences/libs/claude-code-marketplace/plugins/backstage",
    "~/development/gitlab/CordialExperiences/libs/claude-code-marketplace/plugins/release-tools",
    "~/development/gitlab/CordialExperiences/libs/claude-code-marketplace/plugins/renovate-triage",
    "~/development/gitlab/CordialExperiences/libs/claude-code-marketplace/plugins/tofu-terraform"
  ],
  "providers": {
    "openrouter": {
      "settings": {
        "providerOptions": {
          "provider": {
            "quantizations": ["fp8", "fp16", "bf16", "fp32"],
            "sort": "price"
          }
        }
      },
      "models": {
        "z-ai/glm-5.3": {
          "settings": {
            "providerOptions": {
              "provider": {
                "order": ["novita"]
              }
            }
          }
        },
        "z-ai/glm-5.3-flash": {
          "settings": {
            "providerOptions": {
              "provider": {
                "order": ["baseten"],
                "sort": "throughput"
              }
            }
          }
        },
        "moonshotai/kimi-k3": {
          "settings": {
            "providerOptions": {
              "provider": {
                "quantizations": ["fp4", "fp8", "fp16", "bf16", "fp32"],
                "order": ["modal"]
              }
            }
          }
        }
      }
    },
    "cloudflare-workers-ai": {
      "settings": {
        "baseURL": "https://api.cloudflare.com/client/v4/accounts/a2a6651ef38e5dbabfc7f77e51d0d35b/ai/v1"
      },
      "models": {
        "@cf/zai-org/glm-5.3-flash": {
          "name": "GLM 5.3 Flash",
          "settings": {
            "providerOptions": {
              "reasoningEffort": "high"
            }
          },
          "variants": [
            {
              "id": "high",
              "settings": {
                "providerOptions": {
                  "reasoningEffort": "high"
                }
              }
            },
            {
              "id": "medium",
              "settings": {
                "providerOptions": {
                  "reasoningEffort": "medium"
                }
              }
            }
          ]
        },
        "@cf/zai-org/glm-5.3": {
          "name": "GLM 5.3",
          "settings": {
            "providerOptions": {
              "reasoningEffort": "high"
            }
          },
          "variants": [
            {
              "id": "high",
              "settings": {
                "providerOptions": {
                  "reasoningEffort": "high"
                }
              }
            }
          ]
        }
      }
    },
    "amazon-bedrock": {
      "settings": {
        "auth": "sigv4",
        "region": "us-west-2"
      }
    },
    "bedrock-mantle": {
      "name": "Bedrock Mantle",
      "package": "@opencode-ai/ai/providers/amazon-bedrock/mantle",
      "settings": {
        "auth": "sigv4",
        "region": "us-west-2"
      },
      "models": {
        "gpt-5.6-luna": {
          "modelID": "openai.gpt-5.6-luna",
          "name": "GPT-5.6 Luna",
          "settings": {
            "providerOptions": {
              "reasoningEffort": "max"
            }
          },
          "limit": {
            "context": 1000000,
            "output": 256000
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "providerOptions": {
                  "reasoningEffort": "low"
                }
              }
            },
            {
              "id": "medium",
              "settings": {
                "providerOptions": {
                  "reasoningEffort": "medium"
                }
              }
            },
            {
              "id": "max",
              "settings": {
                "providerOptions": {
                  "reasoningEffort": "max"
                }
              }
            }
          ]
        },
        "gpt-5.6-terra": {
          "modelID": "openai.gpt-5.6-terra",
          "name": "GPT-5.6 Terra",
          "settings": {
            "providerOptions": {
              "reasoningEffort": "max"
            }
          },
          "limit": {
            "context": 1000000,
            "output": 256000
          }
        },
        "gpt-5.6-sol": {
          "modelID": "openai.gpt-5.6-sol",
          "name": "GPT-5.6 Sol",
          "settings": {
            "region": "us-east-1",
            "providerOptions": {
              "reasoningEffort": "max"
            }
          },
          "limit": {
            "context": 1000000,
            "output": 256000
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp/oauth"
      },
      "aws-mcp": {
        "type": "local",
        "command": [
          "uvx",
          "mcp-proxy-for-aws@1.7.0",
          "https://aws-mcp.us-east-1.api.aws/mcp",
          "--skip-auth",
          "--metadata",
          "INSTALL_SOURCE=agent-toolkit"
        ],
        "environment": {
          "AWS_MCP_PROXY_PROFILES": "Cordial-Development/ReadOnly Cordial-Production-East/ReadOnly Cordial-Production/ReadOnly MTA-dev/ReadOnly MTA/ReadOnly Production-Bravo/ReadOnly SRE-dev/ReadOnly SRE-prod/ReadOnly cordial-ecr/ReadOnly datalake/ReadOnly dev-datalake/ReadOnly sre-interview-sandbox/ReadOnly security-tooling/FullAccess"
        }
      },
      "eng-mcp": {
        "type": "remote",
        "url": "https://eng-mcp.ops.cordial.io/mcp?codemode=search_and_execute"
      },
      "eng-mcp-dev": {
        "type": "remote",
        "url": "https://eng-mcp.cordialdev.com/mcp?codemode=search_and_execute"
      }
    }
  }
}
