{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "/Users/danielschaaff/development/gitlab/CordialExperiences/libs/claude-code-marketplace/plugins/tofu-terraform"
  ],
  "providers": {
    "openrouter": {
      "body": {
        "provider": {
          "quantizations": [
            "fp8",
            "fp16",
            "bf16",
            "fp32"
          ],
          "sort": "price"
        }
      },
      "models": {
        "z-ai/glm-5.3": {
          "body": {
            "provider": {
              "order": [
                "novita"
              ]
            }
          }
        },
        "z-ai/glm-5.3-flash": {
          "body": {
            "provider": {
              "order": [
                "baseten"
              ],
              "sort": "throughput"
            }
          }
        },
        "moonshotai/kimi-k3": {
          "body": {
            "provider": {
              "quantizations": [
                "fp4",
                "fp8",
                "fp16",
                "bf16",
                "fp32"
              ],
              "order": [
                "modal"
              ]
            }
          }
        }
      }
    },
    "cloudflare-workers-ai": {
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.cloudflare.com/client/v4/accounts/a2a6651ef38e5dbabfc7f77e51d0d35b/ai/v1"
      },
      "models": {
        "@cf/zai-org/glm-5.3-flash": {
          "name": "GLM 5.3 Flash",
          "settings": {
            "reasoningEffort": "high"
          },
          "variants": [
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high"
              }
            },
            {
              "id": "medium",
              "settings": {
                "reasoningEffort": "medium"
              }
            }
          ]
        },
        "@cf/zai-org/glm-5.3": {
          "name": "GLM 5.3",
          "settings": {
            "reasoningEffort": "high"
          },
          "variants": [
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high"
              }
            }
          ]
        }
      }
    },
    "bedrock-mantle": {
      "name": "Bedrock Mantle",
      "package": "aisdk:@ai-sdk/openai",
      "settings": {
        "baseURL": "https://bedrock-mantle.us-west-2.api.aws/openai/v1",
        "apiKey": "{env:BEDROCK_SECRET}"
      },
      "models": {
        "gpt-5.6-luna": {
          "modelID": "openai.gpt-5.6-luna",
          "name": "GPT-5.6 Luna",
          "settings": {
            "reasoningEffort": "max"
          },
          "limit": {
            "context": 1000000,
            "output": 256000
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low"
              }
            },
            {
              "id": "medium",
              "settings": {
                "reasoningEffort": "medium"
              }
            },
            {
              "id": "max",
              "settings": {
                "reasoningEffort": "max"
              }
            }
          ]
        },
        "gpt-5.6-terra": {
          "modelID": "openai.gpt-5.6-terra",
          "name": "GPT-5.6 Terra",
          "settings": {
            "reasoningEffort": "max"
          },
          "limit": {
            "context": 1000000,
            "output": 256000
          }
        },
        "gpt-5.6-sol": {
          "modelID": "openai.gpt-5.6-sol",
          "name": "GPT-5.6 Sol",
          "settings": {
            "baseURL": "https://bedrock-mantle.us-east-1.api.aws/openai/v1",
            "reasoningEffort": "max"
          },
          "limit": {
            "context": 1000000,
            "output": 256000
          }
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp/oauth",
      "enabled": true
    },
    "aws-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-proxy-for-aws@1.6.0",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--skip-auth",
        "--metadata",
        "INSTALL_SOURCE=agent-toolkit"
      ],
      "environment": {
        "AWS_MCP_PROXY_PROFILES": "Cordial-Development/ReadOnly Cordial-Production-East/ReadOnly Cordial-Production/ReadOnly MTA-dev/ReadOnly MTA/ReadOnly Production-Bravo/ReadOnly SRE-dev/ReadOnly SRE-prod/ReadOnly cordial-ecr/ReadOnly datalake/ReadOnly dev-datalake/ReadOnly sre-interview-sandbox/ReadOnly security-tooling/FullAccess"
      },
      "enabled": true
    },
    "eng-mcp": {
      "type": "remote",
      "url": "https://eng-mcp.ops.cordial.io/mcp?codemode=search_and_execute",
      "enabled": true
    },
    "eng-mcp-dev": {
      "type": "remote",
      "url": "https://eng-mcp.cordialdev.com/mcp?codemode=search_and_execute",
      "enabled": true
    }
  }
}